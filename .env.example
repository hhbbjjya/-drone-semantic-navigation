# 複製成 .env 後填入；.env 已列入 .gitignore，絕不提交。
# 每台機器各自一份 .env。

# 本機角色：onboard（Orin Nano）| vlm（5070 Ti 桌機）| slam（5070 筆電）
DSN_ROLE=

# 研究資料根目錄（模型、資料集、輸出都放這裡，不放在 repo 內）
DSN_DATA_ROOT=$HOME/dsn-data

# Hugging Face（只有需要下載受限模型時才填）
HF_TOKEN=

# ROS 2 網路（三台必須相同）
ROS_DOMAIN_ID=42

# 機上行動網卡（之後加裝時使用）
CELL_APN=
CELL_USER=
CELL_PASSWORD=
